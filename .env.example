# ========================================
# JARVIS Environment Configuration
# ========================================

# Model Configuration
JARVIS_DEFAULT_MODEL=claude-opus-4-7
JARVIS_ROUTING_MODEL=claude-opus-4-7
JARVIS_FALLBACK_MODEL=gemini/gemini-2.0-flash

# API Keys (required for production)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
MISTRAL_API_KEY=your-mistral-api-key-here

# LiteLLM Configuration
LITELLM_LOG=FALSE
LITELLM_CACHE=False

# Redis Configuration (for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8501
SERVER_LOG_LEVEL=warning

# Feature Flags
ENABLE_CACHING=true
ENABLE_MEMORY_AGENT=true
ENABLE_VECTOR_ROUTING=false
ENABLE_OBSERVABILITY=false

# IP Whitelist (security)
# Set ENABLE_IP_WHITELIST=true to restrict access to specific IPs only
# Local/private IPs (192.168.x.x, 10.x.x.x, etc.) are always allowed
# Add IPs with: python main.py --authorize-ip=82.1.2.3
ENABLE_IP_WHITELIST=false
ALLOWED_IPS=

# Observability Configuration
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Ollama Configuration (for local inference)
# These are set automatically by install-JARVIS-V1.0.sh
# JARVIS_DEFAULT_MODEL=ollama/llama3.2:3b       (fast: 20-40 tok/s)
# JARVIS_ROUTING_MODEL=ollama/llama3.2:3b
# JARVIS_FALLBACK_MODEL=ollama/mistral-small3.2 (quality: 3-8 tok/s)
OLLAMA_KEEP_ALIVE=-1              # Keep models in RAM permanently
OLLAMA_MAX_LOADED_MODELS=2        # Max 2 models simultaneously
OLLAMA_NUM_THREAD=4               # Use 4 CPU threads (auto-detected on install)
OLLAMA_API_BASE=http://localhost:11434

# TTS Configuration
# Kokoro (port 8000) — serveur local, voir ../jarvis-voice/tts_server4.py
TTS_BACKEND=http://127.0.0.1:8000
# Voxtral (port 8001) — API Mistral, nécessite MISTRAL_API_KEY ci-dessus
TTS_VOXTRAL_BACKEND=http://127.0.0.1:8001
VOXTRAL_MODEL=voxtral-v0-2
